# ─────────────────────────────────────────────────────────────────────────────
# mobile/ env — copy to `.env` and fill in as needed.
#
# Expo picks up any variable prefixed with EXPO_PUBLIC_ and exposes it via
# `process.env.EXPO_PUBLIC_*` at runtime. Anything else is build-time only.
#
# The default apiBaseUrl lives in app.json (`extra.apiBaseUrl`). If you set
# EXPO_PUBLIC_API_BASE_URL here it overrides that default at bundle time.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the app should look for the api-gateway ─────────────────────────
#
# iOS Simulator on this Mac:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
#
# Android Emulator (localhost is the emulator itself, not the host):
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api
#
# Physical device on the same Wi-Fi — use your Mac's LAN IP:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8080/api
#
# EAS build for TestFlight / Play Internal — your actual deployed gateway:
#   EXPO_PUBLIC_API_BASE_URL=https://api.college-erp.example.com/api

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
