# ─────────────────────────────────────────────────────────────────────────────
# LMS v2.0 — local environment template
# Copy this file to `.env` (same directory) and fill in real values before
# `docker compose up`. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# JWT signing key — MUST be at least 32 characters (256 bits).
# Both auth-service and api-gateway fail to start with a shorter value.
# Generate locally:  openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=replace-me-with-a-256-bit-random-string-at-least-32-chars

# ── Postgres (shared instance, 12 logical DBs) ───────────────────────────────

POSTGRES_USER=lmsadmin
POSTGRES_PASSWORD=changeme

# ── Frontend ─────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173

# ── Cookie behaviour (auth-service) ──────────────────────────────────────────
# In local dev: secure=false, sameSite=Lax.
# In production over HTTPS: secure=true and (optionally) sameSite=None for
# cross-origin browser SPAs, otherwise Lax.

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
COOKIE_MAX_AGE_MS=86400000

# ── JWT lifetimes (override defaults) ────────────────────────────────────────
JWT_ACCESS_MS=86400000
JWT_REFRESH_MS=604800000

# ── Mail (notification-service) ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Active Spring profile ────────────────────────────────────────────────────
# `local`  — dev defaults, no HTTPS cookies, verbose logging
# `prod`   — Secure cookies, INFO logs, expects AWS Secrets Manager
SPRING_PROFILES_ACTIVE=local
