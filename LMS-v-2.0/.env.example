# ─────────────────────────────────────────────────────────────────────────────
# LMS v2.0 — local environment template
# Copy this file to `.env` (same directory) and fill in real values before
# `docker compose up`. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# JWT signing key — MUST be at least 32 characters (256 bits).
# Both auth-service and api-gateway fail to start with a shorter value.
# Generate locally:  openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=replace-me-with-a-256-bit-random-string-at-least-32-chars

# ── Postgres (shared instance, 12 logical DBs) ───────────────────────────────

POSTGRES_USER=lmsadmin
POSTGRES_PASSWORD=changeme

# ── Frontend ─────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173

# ── Cookie behaviour (auth-service) ──────────────────────────────────────────
# In local dev: secure=false, sameSite=Lax.
# In production over HTTPS: secure=true and (optionally) sameSite=None for
# cross-origin browser SPAs, otherwise Lax.

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
COOKIE_MAX_AGE_MS=86400000

# ── JWT lifetimes (override defaults) ────────────────────────────────────────
JWT_ACCESS_MS=86400000
JWT_REFRESH_MS=604800000

# ── JWT claim binding — different per environment ────────────────────────────
# auth-service signs tokens with these iss + aud; gateway requires matching
# values. Production should set distinct values per environment so a leaked
# staging secret cannot impersonate prod and vice-versa.

JWT_ISSUER=lms-auth-service
JWT_AUDIENCE=lms-gateway
JWT_CLOCK_SKEW=30

# ── Mail (notification-service) ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Active Spring profile ────────────────────────────────────────────────────
# `local`  — dev defaults, no HTTPS cookies, verbose logging
# `prod`   — Secure cookies, INFO logs, expects AWS Secrets Manager
SPRING_PROFILES_ACTIVE=local

# ── Per-service Postgres credentials (least-privilege) ───────────────────────
# Each service connects with its own role that has rights only to its DB.
# Created by infra/db/init-databases.sql on first compose-up. Override the
# passwords here for production; ALTER ROLE … PASSWORD after first boot.

AUTH_DB_USER=lms_auth_user
AUTH_DB_PASSWORD=changeme
USER_DB_USER=lms_user_user
USER_DB_PASSWORD=changeme
COURSE_DB_USER=lms_course_user
COURSE_DB_PASSWORD=changeme
EXAM_DB_USER=lms_exam_user
EXAM_DB_PASSWORD=changeme
ATTENDANCE_DB_USER=lms_attendance_user
ATTENDANCE_DB_PASSWORD=changeme
FINANCE_DB_USER=lms_finance_user
FINANCE_DB_PASSWORD=changeme
HR_DB_USER=lms_hr_user
HR_DB_PASSWORD=changeme
NOTIFICATION_DB_USER=lms_notification_user
NOTIFICATION_DB_PASSWORD=changeme
ACADEMICS_DB_USER=lms_academics_user
ACADEMICS_DB_PASSWORD=changeme
FEEDBACK_DB_USER=lms_feedback_user
FEEDBACK_DB_PASSWORD=changeme
RESEARCH_DB_USER=lms_research_user
RESEARCH_DB_PASSWORD=changeme
SERVICES_DB_USER=lms_services_user
SERVICES_DB_PASSWORD=changeme
